+
+float axialRoll(math::Quat rotation, math::Quat neutral, math::Vec3 axis) {
+    const auto delta = animation::multiply(rotation, animation::conjugate(neutral));
+    const float along = dot({delta.x, delta.y, delta.z}, axis);
+    // Double angle makes the measurement independent of quaternion hemisphere.
+    return std::atan2(2.F * along * delta.w, delta.w * delta.w - along * along);
+}
