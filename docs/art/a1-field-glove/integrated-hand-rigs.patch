+    targets.projectSupportRelease = 1.F;
+    require(applyPlayerHandConstraints(rig,skeleton,base,global,targets,solved,final,&evaluator).applied(), "magazine pose is reachable");
+    std::cout << "Project grip tip shift m=" << std::sqrt((fingerPoint(final)-correctedTip).lengthSquared()) << '\n';
+    require(
+            deltaDegrees(base.joints[second].rotation,solved.joints[second].rotation) < .01F &&
+            std::sqrt((fingerPoint(final)-correctedTip).lengthSquared()) < .004F,
+            "magazine pose is restored and grip correction keeps fingertip within four millimetres");
