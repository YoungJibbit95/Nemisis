+// A real weighted joint half way down each Project forearm lets the sleeve
+// follow pronation. Rotate around the joint-to-wrist lines in the actual
+// scaled pose. Neither roll is allowed to displace the wrist endpoint.
+bool shareProjectForearmRoll(const animation::Skeleton& skeleton, const HandIKArm& arm, const M3& desired,
+                             const M3& modelWorld, animation::LocalPose& local, const animation::GlobalPose& global) {
+    const auto distal = skeleton.joints[arm.wrist].parent;
+    const auto upper = skeleton.joints[arm.elbow].parent;
+    const auto& hand = local.joints[arm.wrist];
+    const auto neutral = skeleton.joints[arm.wrist].bindLocal.rotation;
+    auto& forearm = local.joints[arm.elbow];
+    auto& cuff = local.joints[distal];
+    animation::Mat4 inverseForearm;
+    math::Vec3 foreAxis, cuffAxis, wristAxis;
+    if (!affineInverse(preScale(global.joints[arm.elbow], forearm.scale), inverseForearm) ||
+        !unit(animation::transformPoint(inverseForearm, animation::matrixTranslation(global.joints[arm.wrist])), foreAxis) ||
+        !unit({cuff.scale.x * hand.translation.x, cuff.scale.y * hand.translation.y, cuff.scale.z * hand.translation.z}, cuffAxis) ||
+        !unit(hand.translation, wristAxis)) return false;
+
+    const float roll = axialRoll(hand.rotation, neutral, wristAxis);
+    // The support palm crosses +/-180 degrees in ADS. Bias the middle of the
+    // sleeve toward its authored inward roll at that pose; smooth periodic
+    // terms give the same result on both sides of the crossing and on a seek.
+    const float proximalRoll = 0.68F * (std::cos(roll) - 1.F) + 0.70F * std::sin(roll)
+                             + 0.18F * (1.F - std::cos(2.F * roll));
+    forearm.rotation = animation::multiply(forearm.rotation, around(foreAxis, proximalRoll));
+    const auto foreWorld = animation::multiply(global.joints[upper], animation::matrixFromTransform(forearm));
+    const auto cuffWorld = [&] { return animation::multiply(foreWorld, animation::matrixFromTransform(cuff)); };
+    math::Vec3 offset;
+    if (!orientWrist(skeleton, arm, desired, modelWorld, local, cuffWorld(), offset)) return false;
+    const float remaining = axialRoll(hand.rotation, neutral, wristAxis);
+    constexpr float maxWristRoll = 0.18F;
+    const float distalRoll = remaining - maxWristRoll * std::sin(remaining);
+    cuff.rotation = animation::multiply(cuff.rotation, around(cuffAxis, distalRoll));
+    return orientWrist(skeleton, arm, desired, modelWorld, local, cuffWorld(), offset);
+}
+
+void articulateProjectPinky(const animation::Skeleton& skeleton, std::size_t side, float supportRelease,
+                            animation::LocalPose& local) {
+    const bool left = side == 1;
+    const auto base = animation::findJoint(skeleton, left ? "DEF-f_pinky.01.L" : "DEF-f_pinky.01.R");
+    const auto middle = animation::findJoint(skeleton, left ? "DEF-f_pinky.02.L" : "DEF-f_pinky.02.R");
+    const auto tip = animation::findJoint(skeleton, left ? "DEF-f_pinky.03.L" : "DEF-f_pinky.03.R");
+    if (!base || !middle || !tip || skeleton.joints[*middle].parent != static_cast<int>(*base) ||
+        skeleton.joints[*tip].parent != static_cast<int>(*middle)) return;
+    // The M4 source concentrates the little finger curl at the knuckle
+    // (100/0/0 degrees on the support hand). Use its three cooked hinge
+    // directions. Opening the hand or reaching the exchange grip fades out
+    // the redistribution, so the authored magazine contact remains exact.
+    constexpr float rad = 0.01745329252F;
+    const float mirror = left ? 1.F : -1.F;
+    const std::array<math::Vec3,3> hinges{math::Vec3{.99955F,0,.03007F*mirror},
+        math::Vec3{.99923F,0,.03912F*mirror}, math::Vec3{.99936F,0,.03570F*mirror}};
+    const auto knuckleDelta = animation::multiply(animation::conjugate(skeleton.joints[*base].bindLocal.rotation),
+                                                    local.joints[*base].rotation);
+    const float hinge = axialRoll(knuckleDelta, {}, hinges[0]);
+    const float closed = std::clamp((hinge / rad - 55.F) / 40.F, 0.F, 1.F);
+    const float weight = closed * closed * (3.F - 2.F * closed) * (left ? 1.F - std::clamp(supportRelease,0.F,1.F) : 1.F);
+    const std::array<float,3> correction = left ? std::array{-10.F,15.F,8.F} : std::array{-5.F,7.F,5.F};
+    const std::array joints{*base,*middle,*tip};
+    for (std::size_t i = 0; i < joints.size(); ++i) {
+        auto& rotation = local.joints[joints[i]].rotation;
+        rotation = animation::multiply(rotation, around(hinges[i], correction[i] * rad * weight));
+    }
+}
