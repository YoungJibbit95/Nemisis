+void rifleForearmAndDigits(const animation::Skeleton& skeleton, const PlayerHandConstraintRig& rig,
+                          const animation::GlobalPoseEvaluator& evaluator) {
+    constexpr float rad = 0.01745329252F;
+    const auto around = [](math::Vec3 axis, float angle) {
+        const auto s = std::sin(angle * .5F);
+        return math::Quat{axis.x*s,axis.y*s,axis.z*s,std::cos(angle*.5F)};
+    };
+    const auto deltaDegrees = [=](math::Quat a, math::Quat b) {
+        const auto q = animation::multiply(animation::conjugate(a), b);
+        return 2.F * std::atan2(std::sqrt(q.x*q.x + q.y*q.y + q.z*q.z),std::abs(q.w)) / rad;
+    };
+    auto base = animation::makeBindPose(skeleton);
+    const auto& left = rig.arms[1];
+    const auto distal = skeleton.joints[left.wrist].parent;
+    const auto first = animation::findJoint(skeleton,"DEF-f_pinky.01.L").value();
+    const auto second = animation::findJoint(skeleton,"DEF-f_pinky.02.L").value();
+    const auto last = animation::findJoint(skeleton,"DEF-f_pinky.03.L").value();
+    // Left M4 ready curl from the cook: almost all flexion on the first joint.
+    base.joints[first].rotation = animation::multiply(base.joints[first].rotation,
+        around(unit({.99955F,0,.03007F}),100.F*rad));
+    for (const auto& arm : rig.arms) {
+        base.joints[arm.elbow].rotation = animation::multiply(base.joints[arm.elbow].rotation,
+            around(arm.bendAxisMid,-.65F));
+    }
+    animation::GlobalPose global;
+    require(evaluator.evaluate(base,global), "bent five-joint Project arms evaluate");
+    PlayerHandTargets targets;
+    targets.projectRifleGrip = true;
+    animation::Mat4 right, leftPalm;
+    require(animation::evaluateSocket(skeleton,global,rig.arms[0].socketIndex,right) &&
+            animation::evaluateSocket(skeleton,global,left.socketIndex,leftPalm),"Project grip frames evaluate");
+    targets.rightGripWorld = rigidTarget(right,{});
+    const auto wrist = animation::matrixTranslation(global.joints[left.wrist]);
+    const auto axis = unit(wrist - animation::matrixTranslation(global.joints[distal]));
+    const auto fingerPoint = [&](const animation::GlobalPose& pose) {
+        return animation::transformPoint(pose.joints[last], {0,.014F,0});
+    };
+    animation::LocalPose previous, solved;
+    animation::GlobalPose final;
+    for (const float twist : {-179.F,179.F}) {
+        const auto rotation = around(axis,twist*rad);
+        const auto aboutWrist = animation::matrixFromTransform(
+            {wrist - animation::rotate(rotation,wrist),rotation,{1,1,1}});
+        targets.leftGripWorld = rigidTarget(animation::multiply(aboutWrist,leftPalm),{});
+        const auto result = applyPlayerHandConstraints(rig,skeleton,base,global,targets,solved,final,&evaluator);
+        require(result.reached[0] && result.reached[1] && result.residualMeters[1] < .001F &&
+                result.orientationResidualDegrees[1] < .5F, "rolled Project grips retain position and orientation");
+        const auto wristAxis = unit(base.joints[left.wrist].translation);
+        const auto d = animation::multiply(solved.joints[left.wrist].rotation,
+                                           animation::conjugate(skeleton.joints[left.wrist].bindLocal.rotation));
+        const auto roll = 2.F*std::atan2(dot({d.x,d.y,d.z},wristAxis),d.w);
+        std::cout << "Project rolled wrist=" << std::remainder(roll,6.2831853F)/rad
+                  << " distal=" << deltaDegrees(base.joints[distal].rotation,solved.joints[distal].rotation) << '\n';
+        require(std::abs(std::remainder(roll,6.2831853F)) < 12.F*rad &&
+                deltaDegrees(base.joints[distal].rotation,solved.joints[distal].rotation) > 40.F,
+                "arm roll is carried by weighted forearm, not concentrated in the wrist");
+        require(deltaDegrees(base.joints[second].rotation,solved.joints[second].rotation) > 14.F &&
+                deltaDegrees(base.joints[last].rotation,solved.joints[last].rotation) > 7.F,
+                "closed little finger curls its middle and distal phalanges");
+        if (!previous.joints.empty()) {
+            for (const auto joint : {static_cast<int>(left.elbow),distal,static_cast<int>(left.wrist)})
+                require(deltaDegrees(previous.joints[joint].rotation,solved.joints[joint].rotation) < 4.F,
+                        "whole Project forearm remains continuous across a half turn");
+        }
+        previous = solved;
+    }
+    const auto correctedTip = fingerPoint(final);
+    targets.projectSupportRelease = .5F;
+    require(applyPlayerHandConstraints(rig,skeleton,base,global,targets,solved,final,&evaluator).applied() &&
+            deltaDegrees(base.joints[second].rotation,solved.joints[second].rotation) > 7.F &&
+            deltaDegrees(base.joints[second].rotation,solved.joints[second].rotation) < 8.F,
