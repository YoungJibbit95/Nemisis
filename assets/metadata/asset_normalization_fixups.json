{
  "schema_version": 1,
  "description": "Non-destructive normalization plan for imported Nemisis Project weapon and character GLBs. Source binaries are not edited; tools/blender/normalize_project_assets.py can audit or export reproducible normalized GLBs from this metadata.",
  "coordinate_contract": {
    "blender_target_up_axis": "+Z",
    "blender_target_forward_axis": "-Y",
    "runtime_up_axis": "Y",
    "gameplay_forward_axis": "+Z",
    "gltf_export_yup": true,
    "runtime_dimensions_from_blender_size": ["X", "Z", "Y"]
  },
  "scan_roots": [
    "../Assets",
    "assets"
  ],
  "inventory_keywords": [
    "weapon",
    "wpn",
    "rifle",
    "smg",
    "sidearm",
    "glock",
    "p320",
    "m4",
    "afr",
    "ncar",
    "fr17",
    "hk416",
    "hk-416",
    "character",
    "chr",
    "arms",
    "operator"
  ],
  "global_ignore_mesh_names": [
    "Icosphere"
  ],
  "global_ignore_mesh_name_prefixes": [
    "Icosphere."
  ],
