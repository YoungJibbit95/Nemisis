{
  "schema_version": 1,
  "description": "Non-destructive normalization plan for imported Nemisis Project weapon and character GLBs. Source binaries are not edited; tools/blender/normalize_project_assets.py can audit or export reproducible normalized GLBs from this metadata.",
  "coordinate_contract": {
    "blender_target_up_axis": "+Z",
    "blender_target_forward_axis": "-Y",
    "runtime_up_axis": "Y",
    "gameplay_forward_axis": "+Z",
    "gltf_export_yup": true,
    "runtime_dimensions_from_blender_size": ["X", "Z", "Y"]
  },
  "scan_roots": [
    "../Assets",
    "assets"
  ],
  "inventory_keywords": [
    "weapon",
    "wpn",
    "rifle",
    "smg",
    "sidearm",
    "glock",
    "p320",
    "m4",
    "afr",
    "ncar",
    "fr17",
    "hk416",
    "hk-416",
    "character",
    "chr",
    "arms",
    "operator"
  ],
  "global_ignore_mesh_names": [
    "Icosphere"
  ],
  "global_ignore_mesh_name_prefixes": [
    "Icosphere."
  ],
  "assets": [
    {
      "id": "chr_project_male1",
      "category": "character",
      "source": "assets/project_assets/character_male1.glb",
      "output": "assets/processed/normalized/project_assets/chr_project_male1.glb",
      "aliases": ["character_male1"],
      "findings": [
        "Contains exported Icosphere helper mesh that distorts whole-file bounds.",
        "Contains one GLB skin named rig and four source animation clips: Hard stand, Run (1_18), T_pose, and Walk (1_24).",
        "No authored Nemisis socket_root, socket_camera, socket_weapon_root, hand sockets, first-person arms split, or col_ collision proxy.",
        "Visible character mesh is offset from origin by roughly +0.103m X and -0.109m Y in Blender space."
      ],
      "target_dimensions_m": [0.85176, 0.39996, 1.78599],
      "normalization": {
        "remove_mesh_names": ["Icosphere"],
        "rotation_euler_deg": [0.0, 0.0, 180.0],
        "origin": {
          "mode": "bounds_floor_center",
          "center_axes": ["X", "Y"],
          "floor_axis": "Z"
        },
        "ensure_root_empty": true,
        "add_sockets": [
          {"name": "socket_root", "location": [0.0, 0.0, 0.0], "display_size": 0.08},
          {"name": "socket_camera", "location": [0.0, -0.03, 1.68], "display_size": 0.08},
